# Private event inquiry API
PORT=3001

# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false for STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# The From address must be authorized by your SMTP provider.
EVENT_INQUIRY_FROM="Maggie Mae's Events <events@maggiemaesaustin.com>"
EVENT_INQUIRY_TO=info@maggiemaesaustin.com
